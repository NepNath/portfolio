---
import "../style/common.css";
import "../style/index-page.css";
import Fonts from "./fonts.astro";
interface Props {
    title?: string;
}
const { title = "NepNath" } = Astro.props;
---

<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/img/logo.ico" />
    <title>{title}</title>
    <Fonts />
</head>
    <body>
        <div class="header-container">
                <a class="header-title-container" href="/">
                    <img src="/img/logo.png" alt="logo" class="nep-common-logo" />
                    <span class="nep-common-title header-title">NepNath's <br>Portfolio</span>
                </a>
            <div class="header-detail-container">
                <details class="header-detail-tag text-inside-container">
                    <summary>About Me</summary>
                    <div class="header-dropdown-container">
                        <a class="text-inside-container" target="_blank" rel="noopener" href="/">socials</a><br/>
                        <a class="text-inside-container" target="_blank" rel="noopener" href="https://github.com/NepNath">Github</a><br/>
                    </div>
                </details>
                <details class="header-detail-tag text-inside-container">
                    <summary>My Projects</summary>
                    <div class="header-dropdown-container">
                        <a class="text-inside-container" target="_blank" rel="noopener" href="/">socials</a><br/>
                        <a class="text-inside-container" target="_blank" rel="noopener" href="https://github.com/NepNath">Github</a><br/>
                    </div>
                </details>
                <details class="header-detail-tag text-inside-container" >
                    <summary>My Projects</summary>
                    <div class="header-dropdown-container">
                        <a class="text-inside-container" target="_blank" rel="noopener" href="/">socials</a><br/>
                        <a class="text-inside-container" target="_blank" rel="noopener" href="https://github.com/NepNath">Github</a><br/>
                    </div>
                </details>
            </div>
        </div>
        <main>
            <slot />
        </main>
        <div class="footer-container"> footer
            <div>

            </div>
        </div>
        <script src="../scripts/header.js"></script>
    </body>
</html>