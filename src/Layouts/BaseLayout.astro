---
import "../style/common.css";
import "../style/index-page.css";
import Fonts from "./fonts.astro";
interface Props {
    title?: string;
}
const { title = "NepNath" } = Astro.props;
---

<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/img/logo.ico" />
    <title>{title}</title>
    <Fonts />
</head>
    <body>
    <header>
        <div class="header-container">
            <a class="header-title-container" href="/">
                <img src="/img/logo.png" alt="logo" class="nep-common-logo" />
                <span class="nep-common-title header-title">NepNath's Portfolio</span>
            </a>
        </div>
    </header>
        <main>
            <slot />
        </main>
        <footer>
            <div class="footer-container"> footer
                <span>A</span>
                <span>B</span>
                <span>C</span>
            </div>
        </footer>
    </body>
</html>